---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; sizes: string; class?: string; eager?: boolean; widths?: number[] }
const { src, alt, sizes, class: cls, eager = false, widths = [480, 800, 1200, 1600] } = Astro.props;
---
<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  widths={widths.filter((w) => w <= src.width)}
  sizes={sizes}
  quality={72}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
  class={cls}
/>
