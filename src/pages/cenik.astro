---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { pricing, formatPrice } from '../data/pricing';
---
<Base title="Ceník" description="Kompletní ceník Beauty & Care Janat – kosmetika, řasy a obočí, masáže, manikúra, pedikúra, epilace a kadeřnictví. Praha 5 – Smíchov.">
  <PageHero eyebrow="Ceník služeb" title="Transparentní ceny, <em>žádná překvapení</em>"
    lead="Všechny ceny jsou uvedeny v Kč včetně DPH. Nevíte si rady s výběrem? Zavolejte nám, rádi poradíme." />

  <nav class="cats" aria-label="Kategorie ceníku">
    <div class="container cats__inner">
      {pricing.map((c) => <a href={`#${c.id}`}>{c.title}</a>)}
    </div>
  </nav>

  <div class="container pricing">
    {pricing.map((cat) => (
      <section class="pcat" id={cat.id} aria-labelledby={`h-${cat.id}`}>
        <header class="pcat__head">
          <h2 id={`h-${cat.id}`}>{cat.title}</h2>
          {cat.intro && <p>{cat.intro}</p>}
        </header>
        <div class="pcat__groups">
          {cat.groups.map((g) => (
            <div class="pgroup">
              {g.title && <h3>{g.title}</h3>}
              <ul>
                {g.items.map((it) => (
                  <li class="pitem">
                    <div class="pitem__row">
                      <span class="pitem__name">{it.name}</span>
                      <span class="pitem__dots" aria-hidden="true"></span>
                      {it.duration && <span class="pitem__dur">{it.duration}</span>}
                      <span class="pitem__price">{formatPrice(it.price)}</span>
                    </div>
                    {it.includes && (
                      <details>
                        <summary>Co je v ceně</summary>
                        <ul class="pitem__inc">{it.includes.map((s) => <li>{s}</li>)}</ul>
                      </details>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    ))}

    <div class="pcta">
      <h2>Vybráno? <em>Rezervujte si termín.</em></h2>
      <a href="/rezervace" class="btn btn--light"><Icon name="calendar" size={18} /> Online rezervace</a>
    </div>
  </div>
</Base>

<style>
  .cats { position: sticky; top: 86px; z-index: 40; background: rgba(250,248,246,.95); backdrop-filter: blur(10px); border-block: 1px solid var(--line); }
  .cats__inner { display: flex; gap: .5rem; overflow-x: auto; padding-block: .8rem; scrollbar-width: none; }
  .cats__inner::-webkit-scrollbar { display: none; }
  .cats a { flex: none; text-decoration: none; font-size: .88rem; font-weight: 600; padding: .5rem 1rem; border-radius: 999px; border: 1px solid var(--line); background: var(--white); }
  .cats a:hover { border-color: var(--rose); color: var(--rose-deep); }

  .pricing { padding-block: 3rem 5rem; }
  .pcat { scroll-margin-top: 150px; padding-block: 2.5rem; border-bottom: 1px solid var(--line); display: grid; grid-template-columns: 260px 1fr; gap: 2.5rem; }
  .pcat__head h2 { font-size: clamp(2rem, 4vw, 2.7rem); position: sticky; top: 160px; }
  .pcat__head p { color: var(--ink-soft); font-size: .92rem; }
  .pcat__groups { display: grid; gap: 2.2rem; }
  .pgroup h3 { font-family: var(--sans); font-size: .76rem; letter-spacing: .2em; text-transform: uppercase; font-weight: 600; color: var(--rose-deep); margin-bottom: .6rem; }
  .pgroup > ul { list-style: none; margin: 0; padding: 0; }
  .pitem { padding-block: .7rem; border-bottom: 1px dashed var(--line); }
  .pitem:last-child { border-bottom: 0; }
  .pitem__row { display: flex; align-items: baseline; gap: .8rem; }
  .pitem__name { flex: 0 1 auto; }
  .pitem__dots { flex: 1 1 20px; border-bottom: 1px dotted #c9c5d6; transform: translateY(-4px); min-width: 20px; }
  .pitem__dur { flex: none; font-size: .85rem; color: var(--ink-soft); }
  .pitem__price { flex: none; font-family: var(--serif); font-size: 1.3rem; font-weight: 500; white-space: nowrap; color: var(--ink); }
  details { margin-top: .4rem; font-size: .88rem; }
  summary { cursor: pointer; color: var(--rose-deep); font-weight: 600; width: fit-content; }
  .pitem__inc { columns: 2; column-gap: 2rem; color: var(--ink-soft); margin: .6rem 0 0; padding-left: 1.1rem; }

  .pcta { margin-top: 4rem; background: var(--ink); color: var(--cream); border-radius: var(--radius); padding: clamp(2rem, 5vw, 3.5rem); display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
  .pcta h2 { margin: 0; font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .pcta em { color: var(--blush); }

  @media (max-width: 820px) {
    .pcat { grid-template-columns: 1fr; gap: 1rem; }
    .pcat__head h2 { position: static; }
    .pitem__inc { columns: 1; }
  }
  @media (max-width: 520px) {
    .pitem__row { flex-wrap: wrap; gap: .2rem .8rem; }
    .pitem__name { flex-basis: 100%; }
    .pitem__dots { display: none; }
    .pitem__dur { margin-right: auto; }
    .pitem__price { margin-left: auto; }
  }
</style>
