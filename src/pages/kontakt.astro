---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactInfo from '../components/ContactInfo.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import Photo from '../components/Photo.astro';
import vyloha from '../assets/photos/vyloha.jpg';
---
<Base title="Kontakt" description="Beauty & Care Janat, Plzeňská 354/40, Praha 5 – Smíchov. Telefon, e-mail, provozní doba a jak se k nám dostat.">
  <PageHero eyebrow="Kontakt" title="Přijďte nás <em>navštívit</em>" lead={site.directions} />
  <section class="container kontakt">
    <div class="kontakt__card"><ContactInfo /></div>
    <div class="kontakt__side">
      <figure class="kontakt__photo">
        <Photo src={vyloha} alt="Výloha salonu Janat na ulici Plzeňská" sizes="(max-width: 820px) 92vw, 460px" widths={[480, 800, 1000]} />
        <figcaption>Hledejte tuhle výlohu na Plzeňské</figcaption>
      </figure>
      <div class="tip"><Icon name="pin" size={22} /><div><strong>Metro Anděl (B)</strong>cca 10 minut pěšky po ulici Plzeňská</div></div>
      <div class="tip"><Icon name="pin" size={22} /><div><strong>Tramvaj – zastávka Bertramka</strong>odtud minuta chůze</div></div>
      <div class="tip"><Icon name="pin" size={22} /><div><strong>Nákupní centrum Nový Smíchov</strong>jsme kousek od něj</div></div>
      <a class="btn btn--ghost" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">Navigovat v Google Mapách <Icon name="arrow" size={18} /></a>
      <a class="btn btn--primary" href="/rezervace"><Icon name="calendar" size={18} /> Rezervovat termín</a>
    </div>
  </section>
</Base>
<style>
  .kontakt { display: grid; grid-template-columns: 1.1fr .9fr; gap: 2rem; padding-bottom: 5rem; }
  .kontakt__card { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(1.6rem, 4vw, 2.6rem); box-shadow: var(--shadow); }
  .kontakt__side { display: flex; flex-direction: column; gap: 1rem; }
  .kontakt__photo { margin: 0 0 .5rem; border-radius: var(--radius); overflow: hidden; position: relative; aspect-ratio: 16 / 10; }
  .kontakt__photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .kontakt__photo figcaption { position: absolute; left: 1rem; bottom: 1rem; background: rgba(255,255,255,.94); padding: .45rem .9rem; border-radius: 999px; font-size: .85rem; font-weight: 600; }
  .tip { display: flex; gap: .9rem; padding: 1.1rem 1.2rem; background: var(--sand); border-radius: var(--radius-sm); }
  .tip :global(svg) { flex: none; color: var(--rose-deep); margin-top: .2rem; }
  .tip strong { display: block; }
  .tip div { color: var(--ink-soft); font-size: .95rem; }
  .tip div strong { color: var(--ink); }
  @media (max-width: 820px) { .kontakt { grid-template-columns: 1fr; } }
</style>
